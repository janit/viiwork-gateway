# viiwork-gateway configuration.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── The mesh ────────────────────────────────────────────────────────────────
#
# The gateway joins the viiwork 2 mesh as a member that serves no models. It
# discovers every node from membership, so there is no node list to maintain
# here: a host that comes up is usable within a capacity poll.
#
# A mesh is either secured or open, and you must choose explicitly. Secured is
# recommended behind a gateway: membership is then authenticated, and only
# secret holders can join and be routed to.
#
# The secret is 32 bytes, base64. Generate with:
#   openssl rand -base64 32
# It must match every node's mesh secret.
VIIWORK_MESH_SECRET=CHANGE_ME

# Set during a secret rotation so members still on the old key can be read.
# Requires VIIWORK_MESH_SECRET.
#VIIWORK_MESH_SECRET_PREV=

# An open mesh instead: any viiwork node that can reach the gossip port joins.
# Mutually exclusive with VIIWORK_MESH_SECRET, and requires
# VIIWORK_GW_VIEW_NODES below.
#VIIWORK_GW_MESH_OPEN=true

# This member's name on the mesh. Defaults to the hostname; it appears in the
# access log and in every other member's list, and must be unique.
#VIIWORK_GW_NODE_NAME=

# tailnet (default) or lan. Decides which discovery feeder runs by default and
# which peer addresses are acceptable.
#VIIWORK_GW_MESH_NETWORK=tailnet

# Gossip, tcp and udp both. Default 7946.
#VIIWORK_GW_MESH_BIND_PORT=7946

# The address gossip binds and advertises. Empty resolves it from the network
# (the tailnet address via tailscaled, or the default route on a LAN).
#VIIWORK_GW_MESH_ADVERTISE=

# Encryption enforcement: full (default), outgoing, or none. Below full needs
# a secret; it exists for rolling a mesh onto encryption, not as a setting.
#VIIWORK_GW_MESH_ENFORCE=full

# Discovery feeders. auto (default) follows VIIWORK_GW_MESH_NETWORK: the
# tailnet feeder on a tailnet, mDNS on a LAN. Either can be forced.
#VIIWORK_GW_MESH_TAILNET=auto
#VIIWORK_GW_MESH_MDNS=auto
#VIIWORK_GW_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# Optional gossip entry points, ip:port. Not needed on a tailnet, where the
# feeder finds peers on its own; useful when discovery is off entirely.
#VIIWORK_GW_MESH_SEEDS=100.64.0.2:7946,100.64.0.3:7946

# How often membership is re-attempted after a total partition.
#VIIWORK_GW_MESH_REJOIN_INTERVAL=60s

# ── Routing ─────────────────────────────────────────────────────────────────

# How often each member's free-slot report is read, and how old a report may
# be before its node stops being a routing candidate. StaleAfter must stay
# comfortably above the poll interval.
#VIIWORK_GW_CAPACITY_POLL=1s
#VIIWORK_GW_STALE_AFTER=3s

# The nodes allowed to serve dashboards, /v1/models and GET /v1/aliases, in
# order of preference. REQUIRED in an open mesh: the view node's HTML runs at
# this gateway's authenticated origin, and in an open mesh any viiwork node
# that reaches the gossip port is a member. Empty in a secured mesh means any
# member, chosen stickily.
#VIIWORK_GW_VIEW_NODES=node-a,node-b

# ── The gateway itself ──────────────────────────────────────────────────────

# Where the gateway listens. Loopback only: Caddy is the sole way in.
# Under docker compose this line has no effect: docker-compose.yaml sets
# VIIWORK_GW_LISTEN itself, and its environment: block wins over this file.
# Change it there.
VIIWORK_GW_LISTEN=127.0.0.1:8090

# How long a browser cookie stays valid.
VIIWORK_GW_COOKIE_TTL=720h

# Largest inference request body accepted. Plain bytes, or a KB/MB/GB suffix.
VIIWORK_GW_MAX_BODY=16MB

# Concurrency cap, and the per-request body-read deadline.
#VIIWORK_GW_MAX_INFLIGHT=256
#VIIWORK_GW_BODY_READ_TIMEOUT=30s

# Per-key rate limit on the inference path. 0 disables metering entirely.
#VIIWORK_GW_RATE_PER_MIN=120
#VIIWORK_GW_RATE_BURST=240

# ── Removed in the viiwork 2 gateway ────────────────────────────────────────
#
# These are startup errors now, not ignored settings, because each meant
# something the gateway no longer does:
#
#   VIIWORK_GW_SEEDS           -> VIIWORK_GW_MESH_SEEDS (gossip ip:7946, not
#                                 API addresses; optional on a tailnet)
#   VIIWORK_GW_POLL_INTERVAL   -> VIIWORK_GW_CAPACITY_POLL
#   VIIWORK_GW_POLL_TIMEOUT    -> VIIWORK_GW_CAPACITY_POLL
#   VIIWORK_GW_ALLOW_PRIVATE_PEERS -> VIIWORK_GW_MESH_NETWORK=lan
#   VIIWORK_GW_VIEW_PREFER     -> VIIWORK_GW_VIEW_NODES (node names)

# ── API keys ────────────────────────────────────────────────────────────────
#
# The suffix after VIIWORK_KEY_ is the label that appears in the access log.
# Minimum 24 characters; generate with:
#   openssl rand -base64 32
VIIWORK_KEY_janit=CHANGE_ME_1
VIIWORK_KEY_laptop=CHANGE_ME_2
