# viiwork-gateway configuration.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Where the gateway listens. Loopback only: Caddy is the sole way in.
VIIWORK_GW_LISTEN=127.0.0.1:8090

# Mesh entry points for discovery, comma-separated. These are seeds, not the
# whole fleet — every other node is discovered from them.
VIIWORK_GW_SEEDS=100.64.1.10:8080,100.64.1.11:8080

# Discovery cadence.
VIIWORK_GW_POLL_INTERVAL=10s
VIIWORK_GW_POLL_TIMEOUT=2s

# Optional: pin the node that serves dashboards and per-node views.
# Leave blank to elect one automatically.
VIIWORK_GW_VIEW_PREFER=

# How long a browser cookie stays valid.
VIIWORK_GW_COOKIE_TTL=720h

# Largest inference request body accepted. Plain bytes, or a KB/MB/GB suffix.
VIIWORK_GW_MAX_BODY=16MB

# API keys. The suffix after VIIWORK_KEY_ is the label that appears in the
# access log. Minimum 24 characters; generate with:
#   openssl rand -base64 32
VIIWORK_KEY_janit=CHANGE_ME_1
VIIWORK_KEY_laptop=CHANGE_ME_2
